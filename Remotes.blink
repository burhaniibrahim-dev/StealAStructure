-- these can be ignored if you are using the studio plugin
-- Paths are relative to this file
option ClientOutput = "src/ReplicatedStorage/Shared/Networker/Client.luau"
option ServerOutput = "src/ServerScriptService/Runner/ServerNetwork.luau"

-- Inventory ---------------------------------------------------------------
-- Inventory messages only ever go to the owning player.
-- Revision increases on every mutation; clients drop anything older than what they hold.

map ItemCounts = {[string(1..32)]: u16}

event InventorySnapshot {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		Revision: u32,
		MaxStack: u16,
		Counts: ItemCounts,
	},
}

event InventoryChanged {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		Revision: u32,
		ItemTypeId: string(1..32),
		Count: u16,
	},
}

-- Eggs --------------------------------------------------------------------
-- Every egg belongs to one player and only ever goes to that player: the server never fires egg state to
-- anyone else, and each client clones its own models. The client waits for EggRemoved before removing an egg.
-- Ordering: the server sends nothing live until RequestEggSnapshot arrives, then EggSnapshot, then live
-- EggSpawned / EggRemoved in order on this reliable channel. A snapshot always replaces the client's set.

struct EggRecord {
	PickupId: u32,
	ItemTypeId: string(1..32),
	Amount: u16,
	ZoneId: string(1..32),
	Position: vector,
	RemainingLifetime: f32, -- seconds left on the server clock when sent; display only
}

enum EggRemovedReason = { Collected, Expired, ZoneRemoved, Removed }

event EggSnapshot {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		TriggerRadius: f32, -- PickupConfig.PickupRadius: request collection on entering this range
		Eggs: EggRecord[],
	},
}

event EggSpawned {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: EggRecord,
}

event EggRemoved {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		PickupId: u32,
		Reason: EggRemovedReason,
	},
}

-- Sent once, after the client's egg listeners are registered. The server honours the first request per session
event RequestEggSnapshot {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: u8,
}

-- Identifies only the egg. The owner is the sending player; everything else comes from the server record
event CollectEgg {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		PickupId: u32,
	},
}

-- Rate-limited on the server per player per egg type
event InventoryFull {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		ItemTypeId: string(1..32),
	},
}

-- Targets -----------------------------------------------------------------
-- Target entities are server models in Workspace.Targets, seen by everyone; their state is in model attributes.
-- These events carry only what isn't on a model. Clients send nothing but server-issued TargetIds.

-- To the owning player only: their own run/cooldown state, so starters can look unavailable to them.
-- CooldownEndsAt is workspace:GetServerTimeNow() time (0 = none); presentation only, the server enforces it
event TargetStatus {
	From: Server,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		InRun: boolean,
		CooldownEndsAt: f64,
	},
}

-- The owner's client started showing its scoring target (sent when the appear animation starts)
event TargetShown {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		TargetId: u32,
	},
}

-- Temporary click interaction: the server decides whether it is a claim or damage, and how much
event HitTarget {
	From: Client,
	Type: Reliable,
	Call: SingleSync,
	Data: struct {
		TargetId: u32,
	},
}

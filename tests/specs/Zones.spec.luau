local TestKit = require("../TestKit")
local describe, it, eq, truthy, falsy = TestKit.describe, TestKit.it, TestKit.eq, TestKit.truthy, TestKit.falsy

local function recordChanges(sys)
	local changes = {}
	sys.zones.PlayerZoneChanged:Connect(function(player, newZoneId, oldZoneId)
		table.insert(changes, { Player = player, New = newZoneId, Old = oldZoneId })
	end)
	return changes
end

describe("Zone registration", function()
	it("rejects instances that are not BaseParts", function()
		local sys = TestKit.System()
		local notAPart = TestKit.FakeZonePart({ ZoneId = "X" }, { ClassName = "Folder" })
		eq(sys.zones:Register(notAPart), nil, "registered")
		truthy(sys.warnings[1]:find("not a BasePart"), "diagnostic")
	end)

	it("requires an authored ZoneId and never generates one", function()
		local sys = TestKit.System()
		local part = TestKit.FakeZonePart({})
		eq(sys.zones:Register(part), nil, "registered")
		eq(part:GetAttribute("ZoneId"), nil, "no id written")
		truthy(sys.warnings[1]:find("ZoneId"), "diagnostic")
	end)

	it("is idempotent for the same part", function()
		local sys = TestKit.System()
		local added = 0
		sys.zones.ZoneAdded:Connect(function()
			added += 1
		end)
		local part, zone = sys.addZone("Meadow")
		eq(sys.zones:Register(part), zone, "same zone returned")
		eq(added, 1, "ZoneAdded once")
		eq(#sys.zones:GetZones(), 1, "one zone")
	end)

	it("rejects duplicate ZoneIds and adopts the second once the first is removed", function()
		local sys = TestKit.System()
		local first = sys.addZone("Meadow")
		local second = TestKit.FakeZonePart({ ZoneId = "Meadow" }, { Position = Vector3.new(100, 5, 0) })
		eq(sys.zones:Register(second), nil, "duplicate registered")
		truthy(sys.warnings[#sys.warnings]:find("Duplicate ZoneId"), "diagnostic")
		sys.zones:Unregister(first)
		eq(sys.zones:GetZone("Meadow").Part, second, "second adopted")
	end)

	it("rejects tilted blocks, sideways cylinders, and unsupported shapes", function()
		local sys = TestKit.System()
		local tilted = TestKit.FakeZonePart({ ZoneId = "Tilted" }, { CFrame = CFrame.Angles(0.5, 0, 0) })
		local sideways = TestKit.FakeZonePart({ ZoneId = "Sideways" }, { Shape = "Cylinder" })
		local ball = TestKit.FakeZonePart({ ZoneId = "Ball" }, { Shape = "Ball" })
		eq(sys.zones:Register(tilted), nil, "tilted")
		eq(sys.zones:Register(sideways), nil, "sideways cylinder")
		eq(sys.zones:Register(ball), nil, "ball")
		local upright = TestKit.FakeZonePart(
			{ ZoneId = "Round" },
			{ Shape = "Cylinder", CFrame = CFrame.Angles(0, 0, math.pi / 2), Size = Vector3.new(10, 30, 30) }
		)
		truthy(sys.zones:Register(upright), "upright cylinder")
		truthy(TestKit.ZoneDetection.Contains(sys.zones:GetZone("Round"), Vector3.new(10, 50, 0)), "inside radius, any height")
		falsy(TestKit.ZoneDetection.Contains(sys.zones:GetZone("Round"), Vector3.new(14, 0, 14)), "outside radius")
	end)
end)

describe("Zone detection", function()
	it("switching zones moves the player in the same poll", function()
		local sys = TestKit.System()
		sys.addZone("West", { Position = Vector3.new(-50, 5, 0) })
		sys.addZone("East", { Position = Vector3.new(50, 5, 0) })
		local changes = recordChanges(sys)
		local player = sys.addPlayer("A", Vector3.new(-50, 3, 0))
		sys.zones:Poll()
		sys.roots[player] = Vector3.new(50, 3, 0)
		sys.zones:Poll()
		eq(#changes, 2, "two changes")
		eq(changes[2].Old, "West", "left")
		eq(changes[2].New, "East", "entered immediately")
		eq(sys.zones:GetPopulation("West"), 0, "west population")
		eq(sys.zones:GetPopulation("East"), 1, "east population")
	end)

	it("leaving all zones clears membership", function()
		local sys = TestKit.System()
		sys.addZone("Meadow")
		local changes = recordChanges(sys)
		local player = sys.addPlayer("A", Vector3.new(0, 3, 0))
		sys.zones:Poll()
		sys.roots[player] = Vector3.new(500, 3, 0)
		sys.zones:Poll()
		eq(changes[#changes].New, nil, "now in no zone")
		eq(changes[#changes].Old, "Meadow", "left Meadow")
		eq(sys.zones:GetZoneOf(player), nil, "membership")
		eq(sys.zones:GetPopulation("Meadow"), 0, "population")
	end)

	it("a missing character doesn't stop polling for others", function()
		local sys = TestKit.System()
		sys.addZone("Meadow")
		local ghost = sys.addPlayer("Ghost", nil)
		local player = sys.addPlayer("A", Vector3.new(0, 3, 0))
		sys.zones:Poll()
		eq(sys.zones:GetZoneOf(ghost), nil, "no character, no zone")
		eq(sys.zones:GetZoneOf(player), "Meadow", "others still detected")
		sys.roots[player] = nil -- died mid-zone
		sys.zones:Poll()
		eq(sys.zones:GetPopulation("Meadow"), 0, "dead player leaves population")
	end)

	it("the highest priority wins regardless of order, including the first zone found", function()
		local sys = TestKit.System()
		-- Registered first with the HIGHER priority: the old code never recorded the first zone's priority
		sys.addZone("Inner", { Size = Vector3.new(10, 10, 10), attributes = { Priority = 5 } })
		sys.addZone("Outer", { Size = Vector3.new(100, 10, 100), attributes = { Priority = 1 } })
		local player = sys.addPlayer("A", Vector3.new(0, 3, 0))
		sys.zones:Poll()
		eq(sys.zones:GetZoneOf(player), "Inner", "inner wins")
		sys.roots[player] = Vector3.new(30, 3, 0)
		sys.zones:Poll()
		eq(sys.zones:GetZoneOf(player), "Outer", "outer outside inner")
	end)

	it("resolves equal-priority overlaps deterministically and warns", function()
		local sys = TestKit.System()
		sys.addZone("B")
		sys.addZone("A")
		local player = sys.addPlayer("P", Vector3.new(0, 3, 0))
		sys.zones:Poll()
		eq(sys.zones:GetZoneOf(player), "A", "lowest ZoneId on tie")
		truthy(sys.warnings[#sys.warnings]:find("share Priority"), "tie diagnostic")
	end)

	it("Volume zones respect height, Column zones ignore it", function()
		local sys = TestKit.System()
		sys.addZone("Column", { Position = Vector3.new(0, 50, 0) })
		sys.addZone("Volume", { Position = Vector3.new(100, 50, 0), attributes = { VerticalMode = "Volume" } })
		local a = sys.addPlayer("A", Vector3.new(0, 3, 0))
		local b = sys.addPlayer("B", Vector3.new(100, 3, 0))
		sys.zones:Poll()
		eq(sys.zones:GetZoneOf(a), "Column", "column below hovering zone")
		eq(sys.zones:GetZoneOf(b), nil, "volume below its extent")
	end)
end)

describe("Zone removal", function()
	it("removes every owner's eggs in a removed zone and tells each owner", function()
		local sys = TestKit.System()
		local part = sys.addZone("Meadow")
		local a = sys.addPlayer("A", Vector3.new(10, 3, 10))
		local b = sys.addPlayer("B", Vector3.new(10, 3, 10))
		local eggA = sys.spawnAt(a, "Meadow", 0, 0)
		local eggB = sys.spawnAt(b, "Meadow", 0, 0)
		sys.zones:Poll()

		sys.zones:Unregister(part)
		eq(eggA.State, "Despawned", "A's egg removed")
		eq(eggB.State, "Despawned", "B's egg removed")
		eq(#sys.removals, 2, "one removal per egg")
		eq(sys.removals[1].Reason, "ZoneRemoved", "reason")
		eq(sys.eggRegistry:CountOwnerZone(a.UserId, "Meadow"), 0, "A's zone count")
		eq(sys.eggRegistry:CountOwner(b.UserId), 0, "B's count")
		eq(sys.zones:GetZoneOf(a), nil, "member left")
		eq(sys.time.pendingCount(), 0, "expiry timers cancelled")
	end)

	it("refuses spawns and collection for an invalid zone", function()
		local sys = TestKit.System()
		local player = sys.addPlayer("A", Vector3.new())
		local _, reason = sys.eggs:TrySpawn(player, "Nowhere", "SnowEgg", 1)
		eq(reason, "InvalidZone", "spawn reason")
		eq(sys.zones:CanAccess(player, "Nowhere"), false, "access")
	end)
end)

local TestKit = require("../TestKit")
local describe, it, eq, truthy, falsy = TestKit.describe, TestKit.it, TestKit.eq, TestKit.truthy, TestKit.falsy

local function setup()
	local sys = TestKit.System()
	sys.addZone("Meadow")
	local record = sys.spawnAt("Meadow", 0, 0, "SnowEgg", 1)
	assert(record, "setup spawn failed")
	-- Added after spawning: placement keeps new pickups clear of characters
	local player = sys.addPlayer("A", Vector3.new(0, 3, 0))
	return sys, player, record
end

describe("Stacks", function()
	it("collects at 99 + 1 to reach exactly 100", function()
		local sys, player, record = setup()
		sys.setCount(player, "SnowEgg", 99)
		local ok, count = sys.items:TryCollect(player, record.PickupId)
		truthy(ok, "collected")
		eq(count, 100, "new count")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 100, "inventory")
		eq(sys.registry:Get(record.PickupId), nil, "pickup gone")
		eq(record.State, "Collected", "state")
	end)

	it("rejects at 100 + 1 and leaves the pickup available", function()
		local sys, player, record = setup()
		sys.setCount(player, "SnowEgg", 100)
		local fullEvents = 0
		sys.items.InventoryFull:Connect(function()
			fullEvents += 1
		end)
		local ok, reason = sys.items:TryCollect(player, record.PickupId)
		falsy(ok, "collected")
		eq(reason, "InventoryFull", "reason")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 100, "inventory unchanged")
		eq(sys.registry:Get(record.PickupId), record, "pickup still registered")
		eq(record.State, "Available", "state")
		eq(sys.models.live[record.PickupId], true, "model not destroyed")
		eq(fullEvents, 1, "full notice")

		-- Rate-limited per egg type
		sys.items:TryCollect(player, record.PickupId)
		sys.time.advance(1)
		sys.items:TryCollect(player, record.PickupId)
		eq(fullEvents, 1, "still one notice within cooldown")
		sys.time.advance(1.5)
		sys.items:TryCollect(player, record.PickupId)
		eq(fullEvents, 2, "notice again after cooldown")
	end)

	it("is all-or-nothing when the amount exceeds remaining capacity", function()
		local sys, player = setup()
		local big = sys.spawnAt("Meadow", 10, 10, "SnowEgg", 5)
		sys.roots[player] = Vector3.new(10, 3, 10)
		sys.setCount(player, "SnowEgg", 97)
		local ok, reason = sys.items:TryCollect(player, big.PickupId)
		falsy(ok, "collected")
		eq(reason, "InventoryFull", "reason")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 97, "no partial grant")
		eq(big.State, "Available", "pickup kept")
	end)

	it("keeps stacks separate per egg type", function()
		local sys, player = setup()
		sys.setCount(player, "SnowEgg", 100)
		local ice = sys.spawnAt("Meadow", 10, 0, "IceEgg", 1)
		sys.roots[player] = Vector3.new(10, 3, 0)
		truthy(sys.items:TryCollect(player, ice.PickupId), "ice collected with full snow stack")
		eq(sys.inventory:GetCount(player, "IceEgg"), 1, "ice")
	end)
end)

describe("Duplication", function()
	it("lets only the first of two players collect the same pickup", function()
		local sys, a, record = setup()
		local b = sys.addPlayer("B", Vector3.new(1, 3, 0))
		local okA = sys.items:TryCollect(a, record.PickupId)
		local okB, reasonB = sys.items:TryCollect(b, record.PickupId)
		truthy(okA, "first collects")
		falsy(okB, "second collects")
		eq(reasonB, "NotFound", "second reason")
		eq(sys.inventory:GetCount(a, "SnowEgg") + sys.inventory:GetCount(b, "SnowEgg"), 1, "exactly one egg granted")
	end)

	it("grants once across repeated touch callbacks", function()
		local sys, player, record = setup()
		local collectedEvents = 0
		sys.items.Collected:Connect(function()
			collectedEvents += 1
		end)
		for _ = 1, 6 do -- several body parts touching in one frame
			sys.items:HandleTouch(record.PickupId, player)
		end
		eq(sys.inventory:GetCount(player, "SnowEgg"), 1, "one egg")
		eq(collectedEvents, 1, "one Collected event")
		eq(sys.models.destroyed, 1, "model destroyed once")
		eq(sys.time.pendingCount(), 0, "expiry cancelled")
	end)
end)

describe("Expiry", function()
	it("rejects collection at exactly ExpiresAt and despawns once", function()
		local sys, player, record = setup()
		local despawns = 0
		sys.items.Despawned:Connect(function()
			despawns += 1
		end)
		sys.time.t = record.ExpiresAt -- clock reaches expiry before the timer callback runs
		local ok, reason = sys.items:TryCollect(player, record.PickupId)
		falsy(ok, "collected")
		eq(reason, "Expired", "reason")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 0, "nothing granted")
		sys.time.advance(1) -- the late timer fires now and must do nothing
		eq(despawns, 1, "despawned once")
		eq(sys.models.destroyed, 1, "model destroyed once")
	end)

	it("collection just before expiry invalidates the timer", function()
		local sys, player, record = setup()
		local despawns = 0
		sys.items.Despawned:Connect(function()
			despawns += 1
		end)
		sys.time.advance(record.ExpiresAt - 0.01)
		truthy(sys.items:TryCollect(player, record.PickupId), "collected")
		sys.time.advance(5)
		eq(despawns, 0, "no despawn after collection")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 1, "granted once")
	end)

	it("a stale timer generation does nothing", function()
		local sys, player, record = setup()
		local generation = record.Generation
		sys.items:TryCollect(player, record.PickupId)
		sys.items:_onExpiryTimer(record.PickupId, generation)
		eq(sys.models.destroyed, 1, "not destroyed again")
	end)

	it("expires uncollected pickups on time", function()
		local sys, _, record = setup()
		sys.time.advance(sys.config.PickupLifetime + 0.1)
		eq(sys.registry:Get(record.PickupId), nil, "removed")
		eq(record.State, "Despawned", "state")
	end)
end)

describe("Eligibility", function()
	it("refuses an unloaded profile and keeps the pickup", function()
		local sys, player, record = setup()
		sys.data:Unload(player)
		local ok, reason = sys.items:TryCollect(player, record.PickupId)
		falsy(ok, "collected")
		eq(reason, "ProfileNotActive", "reason")
		eq(record.State, "Available", "kept")
		local added, addReason = sys.inventory:TryAdd(player, "SnowEgg", 1)
		falsy(added, "inventory add without profile")
		eq(addReason, "ProfileNotActive", "inventory reason")
	end)

	it("refuses players without a character", function()
		local sys, player, record = setup()
		sys.roots[player] = nil
		local _, reason = sys.items:TryCollect(player, record.PickupId)
		eq(reason, "NoCharacter", "reason")
	end)

	it("measures distance on the server", function()
		local sys, player, record = setup()
		sys.roots[player] = Vector3.new(15, 3, 0)
		local _, reason = sys.items:TryCollect(player, record.PickupId)
		eq(reason, "TooFar", "reason")
	end)

	it("refuses players who left", function()
		local sys, player, record = setup()
		player.Present = false
		local _, reason = sys.items:TryCollect(player, record.PickupId)
		eq(reason, "PlayerNotPresent", "reason")
	end)

	it("respects the zone access interface", function()
		local sys = TestKit.System({
			canAccess = function()
				return false
			end,
		})
		sys.addZone("Locked")
		local player = sys.addPlayer("A", Vector3.new(0, 3, 0))
		local record = sys.spawnAt("Locked", 0, 0)
		local _, reason = sys.items:TryCollect(player, record.PickupId)
		eq(reason, "ZoneAccess", "reason")
	end)

	it("gates ordinary pickups on server tutorial state", function()
		local sys, player, record = setup()
		truthy(sys.items:SetCollectionEnabled(player, false), "set disabled")
		local ok, reason = sys.items:TryCollect(player, record.PickupId)
		falsy(ok, "collected while locked")
		eq(reason, "TutorialLocked", "reason")
		eq(record.State, "Available", "kept for others")
		sys.items:SetCollectionEnabled(player, true)
		truthy(sys.items:TryCollect(player, record.PickupId), "collected after enabling")
		eq(sys.data:GetData(player).Tutorial.OrdinaryCollectionEnabled, true, "saved in profile")
	end)
end)

describe("Sweep", function()
	it("collects for a player standing still after space frees up", function()
		local sys, player, record = setup()
		sys.setCount(player, "SnowEgg", 100)
		sys.zones:Poll()
		sys.items:SweepProximity()
		eq(record.State, "Available", "kept while full")
		truthy(sys.inventory:TryConsume(player, "SnowEgg", 1), "consume")
		sys.items:SweepProximity()
		eq(record.State, "Collected", "collected by sweep")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 100, "count")
	end)
end)

describe("Analytics", function()
	it("emits first ordinary collection once and aggregates totals", function()
		local sys, player, record = setup()
		local milestones = {}
		sys.analytics.Milestone:Connect(function(_, name)
			table.insert(milestones, name)
		end)
		sys.items:TryCollect(player, record.PickupId)
		local second = sys.spawnAt("Meadow", 10, 10, "SnowEgg", 2)
		sys.roots[player] = Vector3.new(10, 3, 10)
		sys.items:TryCollect(player, second.PickupId)
		eq(#milestones, 1, "one milestone")
		eq(milestones[1], "FirstOrdinaryCollection", "name")
		eq(sys.analytics:GetSourceTotals().Floor.SnowEgg, 3, "floor total")
	end)
end)

local TestKit = require("../TestKit")
local describe, it, eq, truthy, falsy = TestKit.describe, TestKit.it, TestKit.eq, TestKit.truthy, TestKit.falsy

local function setup()
	local sys = TestKit.System()
	sys.addZone("Meadow")
	local player = sys.addPlayer("A", Vector3.new(0, 3, 0))
	local record = sys.spawnAt(player, "Meadow", 0, 0, "SnowEgg", 1)
	assert(record, "setup spawn failed")
	return sys, player, record
end

describe("Records", function()
	it("carry an explicit owner and the authoritative fields", function()
		local _, player, record = setup()
		eq(record.OwnerUserId, player.UserId, "owner")
		eq(record.ItemTypeId, "SnowEgg", "item")
		eq(record.Amount, 1, "amount")
		eq(record.ZoneId, "Meadow", "zone")
		truthy(record.Position, "position")
		eq(record.ExpiresAt, 30, "expiry from PickupLifetime")
		eq(record.Model, nil, "no model on the server")
	end)
end)

describe("Stacks", function()
	it("collects at 99 + 1 to reach exactly 100", function()
		local sys, player, record = setup()
		sys.setCount(player, "SnowEgg", 99)
		local ok, count = sys.eggs:TryCollect(player, record.PickupId)
		truthy(ok, "collected")
		eq(count, 100, "new count")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 100, "inventory")
		eq(sys.eggRegistry:Get(record.PickupId), nil, "egg gone")
		eq(record.State, "Collected", "state")
		eq(sys.removals[1].Reason, "Collected", "owner told it was collected")
	end)

	it("rejects at 100 + 1 and leaves the egg available", function()
		local sys, player, record = setup()
		sys.setCount(player, "SnowEgg", 100)
		local fullEvents = 0
		sys.eggs.InventoryFull:Connect(function()
			fullEvents += 1
		end)
		local ok, reason = sys.eggs:TryCollect(player, record.PickupId)
		falsy(ok, "collected")
		eq(reason, "InventoryFull", "reason")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 100, "inventory unchanged")
		eq(sys.eggRegistry:Get(record.PickupId), record, "egg still registered")
		eq(record.State, "Available", "state")
		eq(#sys.removals, 0, "no removal sent")
		eq(fullEvents, 1, "full notice")

		-- Rate-limited per egg type
		sys.eggs:TryCollect(player, record.PickupId)
		sys.time.advance(1)
		sys.eggs:TryCollect(player, record.PickupId)
		eq(fullEvents, 1, "still one notice within cooldown")
		sys.time.advance(1.5)
		sys.eggs:TryCollect(player, record.PickupId)
		eq(fullEvents, 2, "notice again after cooldown")
	end)

	it("is all-or-nothing when the amount exceeds remaining capacity", function()
		local sys, player = setup()
		local big = sys.spawnAt(player, "Meadow", 10, 10, "SnowEgg", 5)
		sys.roots[player] = Vector3.new(10, 3, 10)
		sys.setCount(player, "SnowEgg", 97)
		local ok, reason = sys.eggs:TryCollect(player, big.PickupId)
		falsy(ok, "collected")
		eq(reason, "InventoryFull", "reason")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 97, "no partial grant")
		eq(big.State, "Available", "egg kept")
	end)

	it("keeps stacks separate per egg type", function()
		local sys, player = setup()
		sys.setCount(player, "SnowEgg", 100)
		local ice = sys.spawnAt(player, "Meadow", 10, 0, "IceEgg", 1)
		sys.roots[player] = Vector3.new(10, 3, 0)
		truthy(sys.eggs:TryCollect(player, ice.PickupId), "ice collected with full snow stack")
		eq(sys.inventory:GetCount(player, "IceEgg"), 1, "ice")
	end)
end)

describe("Ownership", function()
	it("refuses another player's request without touching the egg", function()
		local sys, owner, record = setup()
		local thief = sys.addPlayer("B", Vector3.new(0, 3, 0))
		local ok, reason = sys.eggs:TryCollect(thief, record.PickupId)
		falsy(ok, "collected")
		eq(reason, "NotOwner", "reason")
		eq(record.State, "Available", "still the owner's")
		eq(sys.inventory:GetCount(thief, "SnowEgg"), 0, "thief got nothing")
		truthy(sys.eggs:TryCollect(owner, record.PickupId), "owner still collects")
	end)

	it("a non-owner request after expiry doesn't expire the egg for the owner", function()
		local sys, _, record = setup()
		local thief = sys.addPlayer("B", Vector3.new(0, 3, 0))
		sys.time.t = record.ExpiresAt
		local _, reason = sys.eggs:TryCollect(thief, record.PickupId)
		eq(reason, "NotOwner", "ownership checked first")
		eq(#sys.removals, 0, "no removal triggered by a stranger")
	end)

	it("two players with eggs at the same spot each collect their own", function()
		local sys, a, eggA = setup()
		local b = sys.addPlayer("B", Vector3.new(0, 3, 0))
		local eggB = sys.spawnAt(b, "Meadow", 0, 0, "SnowEgg", 1)
		truthy(eggB, "same spot allowed for another owner")
		truthy(sys.eggs:TryCollect(a, eggA.PickupId), "A collects")
		truthy(sys.eggs:TryCollect(b, eggB.PickupId), "B collects")
		eq(sys.inventory:GetCount(a, "SnowEgg"), 1, "A once")
		eq(sys.inventory:GetCount(b, "SnowEgg"), 1, "B once")
		eq(sys.removals[1].Record.OwnerUserId, a.UserId, "A's removal belongs to A")
		eq(sys.removals[2].Record.OwnerUserId, b.UserId, "B's removal belongs to B")
	end)
end)

describe("Duplication", function()
	it("grants once across repeated requests for one egg", function()
		local sys, player, record = setup()
		local collectedEvents = 0
		sys.eggs.Collected:Connect(function()
			collectedEvents += 1
		end)
		for _ = 1, 6 do
			sys.eggs:HandleCollectRequest(player, record.PickupId)
		end
		eq(sys.inventory:GetCount(player, "SnowEgg"), 1, "one egg")
		eq(collectedEvents, 1, "one Collected event")
		eq(#sys.removals, 1, "one removal")
		eq(sys.time.pendingCount(), 0, "expiry cancelled")
	end)

	it("an unknown or made-up PickupId changes nothing", function()
		local sys, player = setup()
		local _, reason = sys.eggs:HandleCollectRequest(player, 999999)
		eq(reason, "NotFound", "reason")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 0, "nothing granted")
	end)
end)

describe("Request rate limit", function()
	it("drops requests over CollectRequestsPerTick inside one tick window, then resets", function()
		local sys, player = setup()
		for _ = 1, 20 do
			sys.eggs:HandleCollectRequest(player, 999999)
		end
		local _, reason = sys.eggs:HandleCollectRequest(player, 999999)
		eq(reason, "RateLimited", "21st request in the window")
		sys.time.advance(0.25)
		_, reason = sys.eggs:HandleCollectRequest(player, 999999)
		eq(reason, "NotFound", "new window is processed again")
	end)

	it("one player's limit doesn't affect another", function()
		local sys, a = setup()
		local b = sys.addPlayer("B", Vector3.new(0, 3, 0))
		for _ = 1, 21 do
			sys.eggs:HandleCollectRequest(a, 999999)
		end
		local _, reason = sys.eggs:HandleCollectRequest(b, 999999)
		eq(reason, "NotFound", "B processed")
	end)
end)

describe("Expiry", function()
	it("rejects collection at exactly ExpiresAt and removes once", function()
		local sys, player, record = setup()
		sys.time.t = record.ExpiresAt -- clock reaches expiry before the timer callback runs
		local ok, reason = sys.eggs:TryCollect(player, record.PickupId)
		falsy(ok, "collected")
		eq(reason, "Expired", "reason")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 0, "nothing granted")
		sys.time.advance(1) -- the late timer fires now and must do nothing
		eq(#sys.removals, 1, "removed once")
		eq(sys.removals[1].Reason, "Expired", "removal reason")
	end)

	it("collection just before expiry invalidates the timer", function()
		local sys, player, record = setup()
		sys.time.advance(record.ExpiresAt - 0.01)
		truthy(sys.eggs:TryCollect(player, record.PickupId), "collected")
		sys.time.advance(5)
		eq(#sys.removals, 1, "only the collection")
		eq(sys.inventory:GetCount(player, "SnowEgg"), 1, "granted once")
	end)

	it("a stale timer generation does nothing", function()
		local sys, player, record = setup()
		local generation = record.Generation
		sys.eggs:TryCollect(player, record.PickupId)
		sys.eggs:_onExpiryTimer(record.PickupId, generation)
		eq(#sys.removals, 1, "not removed again")
	end)

	it("expires uncollected eggs on time and reports the remaining lifetime from the server clock", function()
		local sys, _, record = setup()
		sys.time.advance(10)
		eq(sys.eggs:GetRemainingLifetime(record), 20, "remaining")
		sys.time.advance(sys.configs.pickupConfig.PickupLifetime)
		eq(sys.eggRegistry:Get(record.PickupId), nil, "removed")
		eq(record.State, "Despawned", "state")
		eq(sys.eggs:GetRemainingLifetime(record), 0, "never negative")
	end)
end)

describe("Eligibility", function()
	it("refuses an unloaded profile and keeps the egg", function()
		local sys, player, record = setup()
		sys.data:Unload(player)
		local ok, reason = sys.eggs:TryCollect(player, record.PickupId)
		falsy(ok, "collected")
		eq(reason, "ProfileNotActive", "reason")
		eq(record.State, "Available", "kept")
		local added, addReason = sys.inventory:TryAdd(player, "SnowEgg", 1)
		falsy(added, "inventory add without profile")
		eq(addReason, "ProfileNotActive", "inventory reason")
	end)

	it("refuses players without a character", function()
		local sys, player, record = setup()
		sys.roots[player] = nil
		local _, reason = sys.eggs:TryCollect(player, record.PickupId)
		eq(reason, "NoCharacter", "reason")
	end)

	it("measures distance on the server", function()
		local sys, player, record = setup()
		sys.roots[player] = Vector3.new(15, 3, 0)
		local _, reason = sys.eggs:TryCollect(player, record.PickupId)
		eq(reason, "TooFar", "reason")
	end)

	it("refuses players who left", function()
		local sys, player, record = setup()
		player.Present = false
		local _, reason = sys.eggs:TryCollect(player, record.PickupId)
		eq(reason, "PlayerNotPresent", "reason")
	end)

	it("respects the zone access interface", function()
		local sys = TestKit.System({
			canAccess = function()
				return false
			end,
		})
		sys.addZone("Locked")
		local player = sys.addPlayer("A", Vector3.new(0, 3, 0))
		local record = sys.spawnAt(player, "Locked", 0, 0)
		local _, reason = sys.eggs:TryCollect(player, record.PickupId)
		eq(reason, "ZoneAccess", "reason")
	end)

	it("refuses ordinary collection while the saved tutorial flag is off", function()
		local sys, player, record = setup()
		sys.data:GetData(player).Tutorial.OrdinaryCollectionEnabled = false
		local ok, reason = sys.eggs:TryCollect(player, record.PickupId)
		falsy(ok, "collected while locked")
		eq(reason, "TutorialLocked", "reason")
		eq(record.State, "Available", "kept")
		sys.data:GetData(player).Tutorial.OrdinaryCollectionEnabled = true
		truthy(sys.eggs:TryCollect(player, record.PickupId), "collected after enabling")
	end)

	it("ordinary collection leaves the deferred milestone flags untouched", function()
		local sys, player, record = setup()
		truthy(sys.eggs:TryCollect(player, record.PickupId), "collected")
		eq(sys.data:GetData(player).Milestones.FirstOrdinaryCollection, false, "milestone not recorded")
	end)
end)

describe("Owner cleanup", function()
	it("removing a player removes only their eggs", function()
		local sys, a, eggA = setup()
		local b = sys.addPlayer("B", Vector3.new(0, 3, 0))
		local eggB = sys.spawnAt(b, "Meadow", 10, 10)
		sys.removePlayer(a)
		eq(eggA.State, "Despawned", "A's egg removed")
		eq(sys.removals[1].Reason, "OwnerLeft", "reason")
		eq(eggB.State, "Available", "B's egg untouched")
		eq(sys.eggRegistry:CountOwner(a.UserId), 0, "A's count")
		eq(sys.eggRegistry:CountOwnerZone(a.UserId, "Meadow"), 0, "A's zone count")
		eq(sys.eggRegistry:CountOwner(b.UserId), 1, "B's count")
		sys.removePlayer(a) -- idempotent
		eq(#sys.removals, 1, "no second removal")
	end)
end)

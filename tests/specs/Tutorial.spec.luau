local TestKit = require("../TestKit")
local describe, it, eq, truthy, falsy = TestKit.describe, TestKit.it, TestKit.eq, TestKit.truthy, TestKit.falsy

local function setup()
	local sys = TestKit.System()
	sys.addZone("Meadow")
	local owner = sys.addPlayer("Owner", Vector3.new(15, 3, 15))
	local other = sys.addPlayer("Other", Vector3.new(16, 3, 15))
	return sys, owner, other
end

describe("Reserved pickups", function()
	it("only the reserved player can collect; others don't consume or block it", function()
		local sys, owner, other = setup()
		local record = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 20, Position = Vector3.new(0, 5, 0) })
		truthy(record, "spawned")
		eq(record.State, "Reserved", "state")
		eq(record.ReservedUserId, owner.UserId, "reserved for owner")
		eq(record.ZoneId, "Meadow", "zone resolved on the server")

		sys.roots[other] = Vector3.new(0, 3, 0)
		sys.roots[owner] = Vector3.new(1, 3, 0)
		local ok, reason = sys.eggs:TryCollect(other, record.PickupId)
		falsy(ok, "other collected")
		eq(reason, "ReservedForOther", "reason")
		eq(sys.inventory:GetCount(other, "SnowEgg"), 0, "other got nothing")

		local collected, count = sys.eggs:TryCollect(owner, record.PickupId)
		truthy(collected, "owner collected")
		eq(count, 20, "tutorial amount larger than ordinary")
	end)

	it("reserved pickups ignore the ordinary tutorial gate but still need space", function()
		local sys, owner = setup()
		sys.eggs:SetCollectionEnabled(owner, false)
		local record = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 10, Position = Vector3.new(0, 5, 0) })
		sys.roots[owner] = Vector3.new(0, 3, 0)
		sys.setCount(owner, "SnowEgg", 95)
		local _, reason = sys.eggs:TryCollect(owner, record.PickupId)
		eq(reason, "InventoryFull", "all-or-nothing")
		sys.setCount(owner, "SnowEgg", 0)
		truthy(sys.eggs:TryCollect(owner, record.PickupId), "collected while ordinary pickups are locked")
	end)

	it("validates the definition on the server", function()
		local sys, owner = setup()
		local _, reason = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 26, Position = Vector3.new() })
		eq(reason, "InvalidAmount", "over MaxReservedAmount")
		_, reason = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "Nope", Amount = 1, Position = Vector3.new() })
		eq(reason, "InvalidItem", "unknown item")
		_, reason = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 1 })
		eq(reason, "InvalidDefinition", "no position")
		for index = 1, 3 do
			truthy(
				sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 1, Position = Vector3.new(index * 6 - 15, 5, 0) }),
				`reserved {index}`
			)
		end
		_, reason = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 1, Position = Vector3.new(10, 5, 10) })
		eq(reason, "ReservedLimit", "per-player limit")
	end)

	it("needs a loaded profile", function()
		local sys = setup()
		local unloaded = sys.addPlayer("Unloaded", Vector3.new(30, 3, 30), false)
		local _, reason = sys.eggs:SpawnReservedPickup(unloaded, { ItemTypeId = "SnowEgg", Amount = 1, Position = Vector3.new() })
		eq(reason, "ProfileNotActive", "reason")
	end)

	it("doesn't spend the shared zone budget", function()
		local sys, owner = setup()
		sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 1, Position = Vector3.new(0, 5, 0) })
		eq(sys.eggRegistry:CountZone("Meadow"), 0, "ordinary zone count")
		eq(sys.eggRegistry:CountReserved(owner.UserId), 1, "reserved count")
	end)

	it("scripted collection works without analytics and leaves milestone flags untouched", function()
		local sys, owner = setup()
		local record = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "IceEgg", Amount = 5, Position = Vector3.new(0, 5, 0) })
		sys.roots[owner] = Vector3.new(0, 3, 0)
		local ok, count = sys.eggs:TryCollect(owner, record.PickupId)
		truthy(ok, "collected")
		eq(count, 5, "inventory count")
		eq(sys.data:GetData(owner).Milestones.FirstScriptedCollection, false, "milestone not recorded")
	end)
end)

describe("Player departure", function()
	it("removes reserved pickups, personal sessions, and zone membership", function()
		local sys, owner, other = setup()
		local record = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 3, Position = Vector3.new(0, 5, 0) })
		local cleaned = 0
		local session = sys.eggs:OpenScriptedSession(owner, "Tutorial", function(activeSession)
			activeSession:AddCleanup(function()
				cleaned += 1
			end)
			coroutine.yield() -- still running a scripted sequence
		end)
		sys.zones:Poll()
		eq(sys.zones:GetPopulation("Meadow"), 2, "population before")

		sys.removePlayer(owner)
		eq(record.State, "Despawned", "reserved pickup removed")
		eq(sys.models.live[record.PickupId], nil, "model destroyed")
		eq(session.Active, false, "session closed")
		eq(cleaned, 1, "session cleanup ran")
		eq(sys.tracks:CountFor(owner), 0, "no sessions left")
		eq(sys.zones:GetPopulation("Meadow"), 1, "population after")
		eq(sys.zones:GetZoneOf(other), "Meadow", "others unaffected")
	end)

	it("RemoveReservedPickups clears only that player's reservations", function()
		local sys, owner, other = setup()
		local mine = sys.eggs:SpawnReservedPickup(owner, { ItemTypeId = "SnowEgg", Amount = 1, Position = Vector3.new(0, 5, 0) })
		local theirs = sys.eggs:SpawnReservedPickup(other, { ItemTypeId = "SnowEgg", Amount = 1, Position = Vector3.new(10, 5, 0) })
		sys.eggs:RemoveReservedPickups(owner)
		eq(mine.State, "Despawned", "mine removed")
		eq(theirs.State, "Reserved", "theirs kept")
	end)
end)

describe("Scripted sessions", function()
	it("reopening a key closes the old session first", function()
		local sys, owner = setup()
		local closed = {}
		local first = sys.eggs:OpenScriptedSession(owner, "Tutorial", function(session)
			session:AddCleanup(function()
				table.insert(closed, "first")
			end)
			coroutine.yield()
		end)
		local second = sys.eggs:OpenScriptedSession(owner, "Tutorial", function()
			coroutine.yield()
		end)
		eq(first.Active, false, "old session closed")
		eq(closed[1], "first", "old cleanup ran")
		eq(coroutine.status(first.Thread), "dead", "old thread cancelled")
		eq(second.Active, true, "new session open")
		eq(sys.tracks:CountFor(owner), 1, "one session")
	end)

	it("a session may close itself from inside its own thread", function()
		local sys, owner = setup()
		local session = sys.eggs:OpenScriptedSession(owner, "Tutorial", function(activeSession)
			sys.eggs:CloseScriptedSession(activeSession.Player, activeSession.Key)
		end)
		eq(session.Active, false, "closed")
		eq(sys.tracks:CountFor(owner), 0, "removed")
	end)
end)
